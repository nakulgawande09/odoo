<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- KB Document Form View -->
    <record id="kb_document_view_form" model="ir.ui.view">
        <field name="name">kb.document.form</field>
        <field name="model">kb.document</field>
        <field name="arch" type="xml">
            <form string="KB Document">
                <header>
                    <button name="action_push_to_kb"
                            type="object"
                            string="Push to KB"
                            class="btn-primary"
                            icon="fa-cloud-upload"/>
                    <button name="action_remove_from_kb"
                            type="object"
                            string="Remove from KB"
                            class="btn-secondary"
                            icon="fa-trash"
                            invisible="kb_status != 'indexed'"
                            confirm="This will remove the document from the knowledge base. Continue?"/>
                    <field name="kb_status" widget="statusbar"
                           statusbar_visible="draft,indexed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Document Title"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Classification">
                            <field name="document_type"/>
                            <field name="tags" placeholder="e.g. returns, shipping, faq"/>
                        </group>
                        <group string="Sync Settings">
                            <field name="auto_sync"/>
                            <field name="kb_chunks_count"
                                   invisible="kb_status != 'indexed'"/>
                            <field name="kb_last_sync"
                                   invisible="kb_status != 'indexed'"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Content -->
                        <page string="Content" name="content">
                            <field name="content"
                                   placeholder="Write or paste your knowledge base content here..."/>
                        </page>

                        <!-- Tab 2: Files -->
                        <page string="Files" name="files">
                            <field name="attachment_ids" widget="many2many_binary"
                                   string="Upload Files"/>
                            <div class="alert alert-info mt-2" role="alert">
                                <strong>Supported formats:</strong>
                                PDF, CSV, HTML, and plain text files.
                                Each file will be chunked and indexed separately.
                            </div>
                        </page>

                        <!-- Tab 3: Notes -->
                        <page string="Notes" name="notes">
                            <field name="notes"
                                   placeholder="Internal notes about this document..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- KB Document Tree View -->
    <record id="kb_document_view_tree" model="ir.ui.view">
        <field name="name">kb.document.tree</field>
        <field name="model">kb.document</field>
        <field name="arch" type="xml">
            <list string="KB Documents" default_order="write_date desc">
                <field name="name"/>
                <field name="document_type"/>
                <field name="tags"/>
                <field name="kb_status"
                       decoration-success="kb_status == 'indexed'"
                       decoration-danger="kb_status == 'failed'"
                       decoration-muted="kb_status == 'draft'"
                       widget="badge"/>
                <field name="kb_chunks_count" string="Chunks"/>
                <field name="kb_last_sync" string="Last Synced"/>
                <field name="write_date" string="Modified"/>
            </list>
        </field>
    </record>

    <!-- KB Document Kanban View -->
    <record id="kb_document_view_kanban" model="ir.ui.view">
        <field name="name">kb.document.kanban</field>
        <field name="model">kb.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="document_type">
                <field name="name"/>
                <field name="document_type"/>
                <field name="kb_status"/>
                <field name="kb_chunks_count"/>
                <field name="tags"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div class="d-flex justify-content-between mt-1">
                            <field name="kb_status" widget="badge"
                                   decoration-success="kb_status == 'indexed'"
                                   decoration-danger="kb_status == 'failed'"
                                   decoration-muted="kb_status == 'draft'"/>
                            <span t-if="record.kb_chunks_count.raw_value">
                                <field name="kb_chunks_count"/> chunks
                            </span>
                        </div>
                        <div t-if="record.tags.raw_value" class="text-muted mt-1 small">
                            <field name="tags"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- KB Document Search View -->
    <record id="kb_document_view_search" model="ir.ui.view">
        <field name="name">kb.document.search</field>
        <field name="model">kb.document</field>
        <field name="arch" type="xml">
            <search string="Search KB Documents">
                <field name="name"/>
                <field name="tags"/>
                <filter string="FAQs" name="faq"
                        domain="[('document_type', '=', 'faq')]"/>
                <filter string="Articles" name="articles"
                        domain="[('document_type', '=', 'article')]"/>
                <filter string="Policies" name="policies"
                        domain="[('document_type', '=', 'policy')]"/>
                <separator/>
                <filter string="Indexed" name="indexed"
                        domain="[('kb_status', '=', 'indexed')]"/>
                <filter string="Draft" name="draft"
                        domain="[('kb_status', '=', 'draft')]"/>
                <filter string="Failed" name="failed"
                        domain="[('kb_status', '=', 'failed')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'document_type'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'kb_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- KB Document Action -->
    <record id="kb_document_action" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">kb.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first Knowledge Base document
            </p>
            <p>
                Create FAQs, articles, policies, and other content
                that the voice agent and search will use to answer questions.
                You can type content directly or upload PDF/CSV/text files.
            </p>
        </field>
    </record>

</odoo>
